VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/your-webhook-id
VITE_N8N_WEBHOOK_URL_TEST=https://your-n8n-instance/webhook-test/your-webhook-id
# prod = usa VITE_N8N_WEBHOOK_URL | test = usa VITE_N8N_WEBHOOK_URL_TEST
VITE_N8N_MODE=prod
# Envío del informe por correo (workflow «Emails» del n8n self-hosted); también respeta VITE_N8N_MODE
VITE_N8N_EMAIL_WEBHOOK_URL=https://your-n8n-instance/webhook/your-email-webhook-id
VITE_N8N_EMAIL_WEBHOOK_URL_TEST=https://your-n8n-instance/webhook-test/your-email-webhook-id
# Base de los webhooks de las automatizaciones (Modelo 1, Tabla CA, Ocupación).
# El path de cada una vive en src/lib/automatizaciones.ts; aquí solo la base.
VITE_N8N_WEBHOOK_BASE=https://your-n8n-instance/webhook
VITE_N8N_WEBHOOK_BASE_TEST=https://your-n8n-instance/webhook-test
